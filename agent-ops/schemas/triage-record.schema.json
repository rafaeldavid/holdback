{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-ops/triage-record.schema.json",
  "title": "TriageRecord",
  "description": "The only thing a triager emits about an untrusted issue or feedback report. Enums, ids and short model-written ASCII text without slashes, brackets or backticks, so no links or markup; no copied text.",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "sourceRef", "kind", "lane", "severity", "fingerprint", "summary", "needsRaw", "needsHuman"],
  "properties": {
    "source": { "enum": ["github_issue", "pr_comment", "feedback", "ci_signal"] },
    "sourceRef": { "$ref": "#/$defs/id" },
    "kind": { "enum": ["bug", "docs", "feature", "feedback", "incident", "flake", "spam"] },
    "lane": { "enum": ["infra", "research", "core", "test", "settlement", "api", "judgment", "demo", "unknown"] },
    "severity": { "enum": ["P0", "P1", "P2", "P3"] },
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{16,64}$" },
    "duplicateOf": { "$ref": "#/$defs/id" },
    "requestId": { "$ref": "#/$defs/id" },
    "summary": { "$ref": "#/$defs/shortText", "type": "string", "maxLength": 200 },
    "observed": { "$ref": "#/$defs/shortText" },
    "expected": { "$ref": "#/$defs/shortText" },
    "pathsGuess": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/repoPath" } },
    "needsRaw": { "type": "boolean" },
    "needsHuman": { "type": "boolean" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "shortText": { "type": "string", "maxLength": 300, "pattern": "^(?!.*:[^ ])[A-Za-z0-9 .,;:'\"()?!%+=_#&-]*$" },
    "repoPath": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.)(?!(.*/)?\\.env)[A-Za-z0-9_./-]{1,120}$" }
  }
}
