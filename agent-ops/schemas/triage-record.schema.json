{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-ops/triage-record.schema.json",
  "title": "TriageRecord",
  "description": "The only thing intake emits about an item, untrusted or not. Enums, ids and short model-written text: no copied text, no URLs, no identities. For social posts, sourceRef is a fingerprint, never a post id or a handle.",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "sourceRef", "kind", "lane", "severity", "route", "fingerprint", "summary", "needsRaw", "needsHuman"],
  "properties": {
    "source": { "enum": ["github_issue", "pr_comment", "feedback", "ci_signal", "web", "social", "api", "onchain"] },
    "sourceRef": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "signal": { "description": "The telemetry rule that fired; absent for text sources.", "type": "string", "pattern": "^[a-z0-9_.-]{1,64}$" },
    "kind": { "enum": ["bug", "docs", "feature", "feedback", "friction", "deprecation", "incident", "flake", "security", "spam"] },
    "lane": { "enum": ["infra", "research", "core", "test", "settlement", "api", "judgment", "demo", "unknown"] },
    "severity": { "enum": ["P0", "P1", "P2", "P3"] },
    "route": { "enum": ["task", "backlog", "decision", "close"] },
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{16,64}$" },
    "duplicateOf": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "summary": { "$ref": "#/$defs/shortText", "type": "string", "maxLength": 200 },
    "observed": { "$ref": "#/$defs/shortText" },
    "expected": { "$ref": "#/$defs/shortText" },
    "pathsGuess": {
      "type": "array",
      "maxItems": 5,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9_./-]{1,120}$" }
    },
    "needsRaw": { "type": "boolean" },
    "needsHuman": { "type": "boolean" }
  },
  "$defs": {
    "shortText": {
      "type": "string",
      "maxLength": 300,
      "not": { "type": "string", "pattern": "([hH][tT][tT][pP][sS]?:|[wW][wW][wW]\\.|\\]\\(|<\\s*/?\\s*[A-Za-z]|@[A-Za-z0-9_]{2,})" }
    }
  }
}
