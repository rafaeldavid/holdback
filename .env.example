# Holdback environment. Copy to .env. Test credentials and testnets only.

# Operator node
HOLDBACK_PORT=8787
HOLDBACK_DB_PATH=./data/holdback.sqlite
# Settlement target: sim (in-process SimChain) | local (anvil) | testnet
HOLDBACK_SETTLEMENT=sim
CHAIN_RPC_URL=
# Must be a testnet or local chain ID; the service refuses mainnet IDs
CHAIN_ID=
# Testnet-only key the operator uses to relay and sponsor gas
OPERATOR_RELAYER_PRIVATE_KEY=

# Adjudicator (keep separate from the operator)
ADJUDICATOR_SIGNING_PRIVATE_KEY=

# Judge providers: at least two model families for the panel
ANTHROPIC_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
THIRD_FAMILY_BASE_URL=
THIRD_FAMILY_API_KEY=

# On-ramp adapter (Phase 5): Stripe test mode only
STRIPE_SECRET_KEY=sk_test_

# Demo agents
DEMO_BUYER_PRIVATE_KEY=
DEMO_SELLER_PRIVATE_KEY=
DEMO_BUYER_PRINCIPAL_PRIVATE_KEY=
DEMO_SELLER_PRINCIPAL_PRIVATE_KEY=
