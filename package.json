{
  "name": "holdback",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "validate:spec": "node scripts/validate-spec.mjs",
    "openapi": "node scripts/openapi.mjs",
    "snap": "tsc -b packages/testkit && node packages/testkit/dist/cli.js",
    "load": "tsc -b packages/settlement && node packages/settlement/dist/sim/load.js",
    "demo": "tsc -b apps/demo && node --env-file-if-exists=.env apps/demo/dist/bin.js",
    "sim": "tsc -b apps/operator && node apps/operator/dist/sim-bin.js",
    "example": "tsc -b examples && node examples/run.ts",
    "sim:world": "tsc -b tools/sim && node tools/sim/bin/world.ts",
    "sim:brief": "node tools/sim/bin/brief.ts",
    "sim:check": "tsc -b tools/sim && node tools/sim/bin/check.ts",
    "sim:stop": "node tools/sim/bin/stop.ts",
    "demo-cloud:dev": "node apps/demo-cloud/scripts/dev.mjs",
    "demo-cloud:e2e": "node apps/demo-cloud/scripts/dev.mjs --deal",
    "demo-cloud:deploy": "node apps/demo-cloud/scripts/deploy.mjs",
    "demo-cloud:deal": "node apps/demo-cloud/scripts/deal.ts",
    "demo-cloud:secrets": "node --env-file-if-exists=.env apps/demo-cloud/scripts/secrets.mjs",
    "verify": "node scripts/verify.ts",
    "map": "node scripts/design-map.mjs",
    "stack": "node scripts/contract-stack.mjs",
    "health": "node scripts/health.mjs",
    "metrics:deal-timing": "node scripts/metrics/deal-timing.mjs",
    "metrics:throughput": "node scripts/metrics/throughput.mjs",
    "metrics:ops-cost": "node scripts/metrics/ops-cost.mjs",
    "metrics:prices": "node scripts/metrics/refresh-prices.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.13.0",
    "rolldown": "1.2.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
