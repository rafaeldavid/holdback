// holdback-op1: operator node 1 of the public demo, and home of the World Durable Object (T-026).
// workers.dev only, test tokens only (SimChain, chain id 31337). No secrets: wrangler's own login deploys it,
// and every key the world holds is generated inside the Durable Object.
{
  "name": "holdback-op1",
  "main": "dist/worker.js",
  "compatibility_date": "2025-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": { "NODE_INDEX": "0", "MIN_WINDOW_SEC": "60" },
  "durable_objects": { "bindings": [{ "name": "WORLD", "class_name": "World" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["World"] }],
  "alias": { "node:fs": "./worker/fs-shim.js" },
  "define": { "import.meta.url": "\"file:///holdback/bundle/a/b/worker.js\"" },
  "observability": { "enabled": true }
}
