// holdback-op1: operator node 1 of the public demo, and home of the World Durable Object (T-026).
// workers.dev only, test tokens only (SimChain, chain id 31337). No secrets: wrangler's own login deploys it,
// and every key the world holds is generated inside the Durable Object.
// The operator fee (ADR-0023, D33) is read from these variables by the World Durable Object, so it applies to
// both nodes: OPERATOR_FEE_BPS (basis points), OPERATOR_FEE_MIN (base units; 0.01 tUSD is "10000"), and an
// optional OPERATOR_FEE_MAX. Remove both to publish no fee; "0" and "0" publish it at zero.
// Workers Logs keeps console lines (errors, and the World's telemetry lines, T-031) but no invocation logs: those
// record each request's headers, which carry Authorization and the caller's IP (D39).
{
  "name": "holdback-op1",
  "main": "dist/worker.js",
  "compatibility_date": "2025-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [{ "pattern": "api.escrow.stream", "custom_domain": true }],
  "preview_urls": false,
  "vars": { "OPERATOR_URLS": "https://api.escrow.stream,https://api2.escrow.stream", "NODE_INDEX": "0", "MIN_WINDOW_SEC": "60", "OPERATOR_FEE_BPS": "1", "OPERATOR_FEE_MIN": "10000" },
  "durable_objects": { "bindings": [{ "name": "WORLD", "class_name": "World" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["World"] }],
  "alias": { "node:fs": "./worker/fs-shim.js" },
  "define": { "import.meta.url": "\"file:///holdback/bundle/a/b/worker.js\"" },
  "observability": { "enabled": true, "logs": { "invocation_logs": false } }
}
