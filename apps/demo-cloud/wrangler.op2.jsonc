// holdback-op2: operator node 2 of the public demo (T-026). It serves the same World Durable Object as
// holdback-op1 (bound by script name), with its own receipt key: one shared simulated settlement layer.
// The operator fee variables live in wrangler.op1.jsonc: the Durable Object reads holdback-op1's environment.
// No invocation logs, as on holdback-op1: they would record each request's headers (D39).
{
  "name": "holdback-op2",
  "main": "dist/worker.js",
  "compatibility_date": "2025-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [{ "pattern": "api2.escrow.stream", "custom_domain": true }],
  "preview_urls": false,
  "vars": { "OPERATOR_URLS": "https://api.escrow.stream,https://api2.escrow.stream", "NODE_INDEX": "1" },
  "durable_objects": { "bindings": [{ "name": "WORLD", "class_name": "World", "script_name": "holdback-op1" }] },
  "alias": { "node:fs": "./worker/fs-shim.js" },
  "define": { "import.meta.url": "\"file:///holdback/bundle/a/b/worker.js\"" },
  "observability": { "enabled": true, "logs": { "invocation_logs": false } }
}
