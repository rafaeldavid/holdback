// holdback-op2: operator node 2 of the public demo (T-026). It serves the same World Durable Object as
// holdback-op1 (bound by script name), with its own receipt key: one shared settlement layer.
// The operator fee variables and the Sepolia secrets live with holdback-op1: the Durable Object reads op1's
// environment. SETTLEMENT (`sim` or `sepolia`, D41) picks the world this Worker forwards to.
// No invocation logs, as on holdback-op1: they would record each request's headers (D39).
// Each node answers on its crow.direct and its escrow.stream hostname alike, with no redirect (T-312): agents POST
// signed messages, which many clients will not resend after a redirect, and the EIP-712 domain names no host.
// The addresses the nodes advertise (OPERATOR_URLS, crow.direct) live with holdback-op1 too: this Worker reads only
// NODE_INDEX, SETTLEMENT and the WORLD binding (T-313).
// T-422 (docs/operator-threat-model.md): FLOOD is this node's flood ceiling, 500 requests per 10 s per client (an IPv4
// address or an IPv6 /64) in each Cloudflare location, answered 429 before the World object; each node has its own
// namespace, so one refusing a client leaves the other's count alone. limits.ts FLOOD_CEILING states the same numbers.
// CF_VERSION_METADATA gives discovery's demo.build.deployedAt (T-413).
{
  "name": "holdback-op2",
  "main": "dist/worker.js",
  "compatibility_date": "2025-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "api2.crow.direct", "custom_domain": true },
    { "pattern": "api2.escrow.stream", "custom_domain": true }
  ],
  "preview_urls": false,
  "vars": { "NODE_INDEX": "1", "SETTLEMENT": "sepolia" },
  "ratelimits": [{ "name": "FLOOD", "namespace_id": "4222", "simple": { "limit": 500, "period": 10 } }],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "durable_objects": { "bindings": [{ "name": "WORLD", "class_name": "World", "script_name": "holdback-op1" }] },
  "alias": { "node:fs": "./worker/fs-shim.js" },
  "define": { "import.meta.url": "\"file:///holdback/bundle/a/b/worker.js\"" },
  "observability": { "enabled": true, "logs": { "invocation_logs": false } }
}
