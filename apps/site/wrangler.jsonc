// crow-site: serves the ’crow site (index.html, llms.txt, images) at escrow.stream as static assets.
// Build the files first: node site/build.mjs --op1 … --op2 … --out reports/site-out
{
  "name": "crow-site",
  "compatibility_date": "2025-09-15",
  "assets": { "directory": "../../reports/site-out", "html_handling": "auto-trailing-slash", "not_found_handling": "404-page" },
  "routes": [
    { "pattern": "escrow.stream", "custom_domain": true },
    { "pattern": "www.escrow.stream", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
