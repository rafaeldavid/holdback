// crow-early-access: early-access email sign-ups for the ’crow site, at join.crow.direct; join.escrow.stream forwards
// to it (worker.js, T-312). One KV namespace for both hostnames.
{
  "name": "crow-early-access",
  "main": "worker.js",
  "compatibility_date": "2025-09-15",
  "workers_dev": true,
  "routes": [
    { "pattern": "join.crow.direct", "custom_domain": true },
    { "pattern": "join.escrow.stream", "custom_domain": true }
  ],
  "preview_urls": false,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "kv_namespaces": [{ "binding": "EMAILS", "id": "4a4fac785319439b9be951fee28bec3a" }],
  "observability": { "enabled": false }
}
