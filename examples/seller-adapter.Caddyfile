# The seller adapter behind HTTPS (T-324; seller-adapter-service.md). Replace quote.example.com with your own
# name, whose DNS points at this machine. Caddy gets and renews the certificate itself, and appends the client's
# address to X-Forwarded-For, which the adapter reads with `trustProxy: true`.
quote.example.com {
	handle /quote {
		reverse_proxy 127.0.0.1:8791
	}
	handle {
		respond 404
	}
}
