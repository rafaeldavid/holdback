{
  "deliverable": {
    "kind": "document",
    "description": "Security review of the code at commit {{commit}}. Scope: {{files}}. Deliver one JSON report with the commit reviewed, the files reviewed and the findings. Each finding has an id, a severity, a title, the file, the line range, the code excerpt it is about, the root cause, the impact and a recommended fix. A finding rated Medium or higher also carries the proof-of-concept files that show it. Severity scale: Critical, anyone can take or lock funds with no special access; High, funds can be taken or locked only with a precondition such as a privileged role or an unusual market state; Medium, the code breaks a stated rule or loses a bounded amount; Low, a defect that puts no funds at risk; Info, a note on clarity, style or cost. A report with no findings is a complete report.",
    "format": "application/json"
  },
  "checks": [
    {
      "id": "report",
      "type": "json_schema",
      "required": true,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "commit",
          "filesReviewed",
          "findings"
        ],
        "properties": {
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "filesReviewed": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "severity",
                "title",
                "file",
                "lines",
                "excerpt",
                "rootCause",
                "impact",
                "recommendedFix"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^F-[0-9]{2,4}$"
                },
                "severity": {
                  "enum": [
                    "Critical",
                    "High",
                    "Medium",
                    "Low",
                    "Info"
                  ]
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "file": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "lines": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "start",
                    "end"
                  ],
                  "properties": {
                    "start": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                },
                "excerpt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "rootCause": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "impact": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "recommendedFix": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "pocFiles": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "content"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "content": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 20000
                      }
                    }
                  }
                }
              },
              "anyOf": [
                {
                  "properties": {
                    "severity": {
                      "enum": [
                        "Low",
                        "Info"
                      ]
                    }
                  }
                },
                {
                  "required": [
                    "pocFiles"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "id": "scope",
      "type": "json_schema",
      "required": true,
      "schema": {
        "type": "object",
        "required": [
          "commit",
          "findings"
        ],
        "properties": {
          "commit": {
            "const": "{{commit}}"
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "file"
              ],
              "properties": {
                "file": {
                  "enum": "{{files}}"
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "coverage",
      "type": "json_schema",
      "required": true,
      "schema": {
        "type": "object",
        "required": [
          "filesReviewed"
        ],
        "properties": {
          "filesReviewed": {
            "type": "array",
            "uniqueItems": true,
            "minItems": "{{files.length}}",
            "maxItems": "{{files.length}}",
            "items": {
              "enum": "{{files}}"
            }
          }
        }
      }
    },
    {
      "id": "hidden",
      "type": "hidden_characters_max",
      "required": true,
      "max": {
        "total": 0
      }
    }
  ]
}
