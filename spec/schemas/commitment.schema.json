{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://holdback.dev/schemas/v0.5/commitment.schema.json",
  "title": "Commitment (terms + EIP-712 signatures)",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "clubId",
    "rulebookHash",
    "buyer",
    "seller",
    "deliverable",
    "acceptance",
    "price",
    "adjudication",
    "timing",
    "settlement",
    "remedy",
    "disclosure",
    "buyerEncryptionPublicKey",
    "nonce",
    "createdAt",
    "signatures"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "0.5"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/Hex32",
      "description": "EIP-712 struct hash of the terms: everything except id, signatures and adjudicatorAcceptance (ADR-0016)"
    },
    "clubId": {
      "$ref": "common.schema.json#/$defs/ClubId"
    },
    "rulebookHash": {
      "$ref": "common.schema.json#/$defs/Hex32"
    },
    "buyer": {
      "$ref": "common.schema.json#/$defs/Address"
    },
    "seller": {
      "$ref": "common.schema.json#/$defs/Address"
    },
    "deliverable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "description",
        "format"
      ],
      "properties": {
        "kind": {
          "enum": [
            "dataset",
            "document",
            "other"
          ]
        },
        "description": {
          "type": "string",
          "maxLength": 4000,
          "x-holdback-untrusted": true
        },
        "format": {
          "enum": [
            "text/csv",
            "application/json",
            "text/plain",
            "text/markdown"
          ]
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "uri",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "uri": {
                "type": "string",
                "format": "uri",
                "x-holdback-untrusted": true,
                "maxLength": 2048
              },
              "sha256": {
                "$ref": "common.schema.json#/$defs/Sha256"
              }
            }
          }
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deterministicChecks",
        "rubric"
      ],
      "properties": {
        "deterministicChecks": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/DeterministicCheck"
          }
        },
        "rubric": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "criteria",
            "passThreshold"
          ],
          "properties": {
            "criteria": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "$ref": "#/$defs/Criterion"
              }
            },
            "passThreshold": {
              "type": "integer",
              "minimum": 0,
              "maximum": 400,
              "description": "Weighted score a delivery needs, in hundredths of a rubric point (300 = 3.00)"
            }
          }
        },
        "sealedChecks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count",
            "commitment",
            "weightBps"
          ],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            "commitment": {
              "$ref": "common.schema.json#/$defs/Hex32",
              "description": "keccak256(canonical checks JSON || salt)"
            },
            "weightBps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3000,
              "description": "Weight of the sealed checks, in basis points (at most 3000)"
            }
          }
        }
      }
    },
    "price": {
      "$ref": "common.schema.json#/$defs/TokenAmount"
    },
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adjudicator",
        "fallbackAdjudicator",
        "appealAdjudicator",
        "policyId",
        "fee",
        "registryHash",
        "policyHash"
      ],
      "properties": {
        "adjudicator": {
          "$ref": "common.schema.json#/$defs/Address"
        },
        "fallbackAdjudicator": {
          "$ref": "common.schema.json#/$defs/Address"
        },
        "appealAdjudicator": {
          "$ref": "common.schema.json#/$defs/Address"
        },
        "policyId": {
          "type": "string",
          "description": "Human-readable label for the policy; policyHash is what binds",
          "x-holdback-untrusted": true,
          "maxLength": 120
        },
        "fee": {
          "$ref": "common.schema.json#/$defs/TokenAmount"
        },
        "registryHash": {
          "$ref": "common.schema.json#/$defs/Hex32",
          "description": "keccak256 of the canonical judge registry the panel is drawn from, bound at agreement (ADR-0006)"
        },
        "policyHash": {
          "$ref": "common.schema.json#/$defs/Hex32",
          "description": "keccak256 of the RFC 8785 canonical JSON of the primary adjudicator's policy object (adjudicator.schema.json), bound at agreement (ADR-0006)"
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offerExpiresAt",
        "fundBy",
        "deliverBy",
        "judgeBy",
        "fallbackBy",
        "appealWindowSec",
        "appealDecideSec",
        "maxSubmissions"
      ],
      "properties": {
        "offerExpiresAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "fundBy": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "deliverBy": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "judgeBy": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "fallbackBy": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "appealWindowSec": {
          "type": "integer",
          "minimum": 1
        },
        "appealDecideSec": {
          "type": "integer",
          "minimum": 1
        },
        "maxSubmissions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "disputeBy": {
          "$ref": "common.schema.json#/$defs/Timestamp",
          "description": "Optimistic mode only: the buyer may dispute until this time; silence after it is acceptance (ADR-0015)"
        },
        "disputeJudgeSec": {
          "type": "integer",
          "minimum": 1,
          "description": "Optimistic mode only: seconds from dispute open for the primary to decide"
        },
        "disputeFallbackSec": {
          "type": "integer",
          "minimum": 1,
          "description": "Optimistic mode only: seconds from dispute open for the fallback to decide"
        }
      }
    },
    "settlement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "token"
      ],
      "properties": {
        "mode": {
          "$ref": "common.schema.json#/$defs/SettlementMode"
        },
        "token": {
          "$ref": "common.schema.json#/$defs/TokenId"
        }
      }
    },
    "remedy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "onReject"
      ],
      "properties": {
        "onReject": {
          "const": "full_refund"
        }
      }
    },
    "buyerEncryptionPublicKey": {
      "$ref": "common.schema.json#/$defs/Base64Url"
    },
    "nonce": {
      "$ref": "common.schema.json#/$defs/Hex32"
    },
    "createdAt": {
      "$ref": "common.schema.json#/$defs/Timestamp"
    },
    "signatures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seller"
      ],
      "properties": {
        "seller": {
          "$ref": "common.schema.json#/$defs/Signature"
        },
        "buyer": {
          "$ref": "common.schema.json#/$defs/Signature"
        }
      }
    },
    "adjudicatorAcceptance": {
      "$ref": "messages.schema.json#/$defs/AdjudicatorAcceptance",
      "description": "The primary adjudicator's signed acceptance, outside the ID. Required before funding (ADR-0016)"
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level"
      ],
      "description": "Signed term: who may read the terms and records (ADR-0020)",
      "properties": {
        "level": {
          "$ref": "common.schema.json#/$defs/DisclosureLevel"
        }
      }
    },
    "privateTerms": {
      "$ref": "common.schema.json#/$defs/PrivateBody",
      "description": "Reserved for private and judgment levels; refused in Phase 1"
    }
  },
  "$defs": {
    "DeterministicCheck": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "required",
            "columns"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9_-]{1,40}$"
            },
            "required": {
              "type": "boolean"
            },
            "type": {
              "const": "csv_columns_exact"
            },
            "columns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "x-holdback-untrusted": true,
                "maxLength": 128
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "required",
            "min",
            "max"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9_-]{1,40}$"
            },
            "required": {
              "type": "boolean"
            },
            "type": {
              "const": "row_count_range"
            },
            "min": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "required",
            "columns"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9_-]{1,40}$"
            },
            "required": {
              "type": "boolean"
            },
            "type": {
              "const": "unique_key"
            },
            "columns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "x-holdback-untrusted": true,
                "maxLength": 128
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "required",
            "column",
            "maxBps"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9_-]{1,40}$"
            },
            "required": {
              "type": "boolean"
            },
            "type": {
              "const": "null_rate_max"
            },
            "column": {
              "type": "string",
              "x-holdback-untrusted": true,
              "maxLength": 128
            },
            "maxBps": {
              "$ref": "common.schema.json#/$defs/Bps",
              "description": "Most null cells allowed in the column, in basis points of rows"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "required",
            "column",
            "pattern",
            "minBps"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9_-]{1,40}$"
            },
            "required": {
              "type": "boolean"
            },
            "type": {
              "const": "regex_match_rate_min"
            },
            "column": {
              "type": "string",
              "x-holdback-untrusted": true,
              "maxLength": 128
            },
            "pattern": {
              "type": "string",
              "maxLength": 200,
              "x-holdback-untrusted": true
            },
            "minBps": {
              "$ref": "common.schema.json#/$defs/Bps",
              "description": "Least share of rows that must match, in basis points"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "required",
            "column"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9_-]{1,40}$"
            },
            "required": {
              "type": "boolean"
            },
            "type": {
              "const": "iso8601_date_column"
            },
            "column": {
              "type": "string",
              "x-holdback-untrusted": true,
              "maxLength": 128
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "required",
            "schema"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9_-]{1,40}$"
            },
            "required": {
              "type": "boolean"
            },
            "type": {
              "const": "json_schema"
            },
            "schema": {
              "type": "object"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "required",
            "reference",
            "keyColumn",
            "minBps"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9_-]{1,40}$"
            },
            "required": {
              "type": "boolean"
            },
            "type": {
              "const": "reference_row_match_min"
            },
            "reference": {
              "type": "object",
              "required": [
                "uri",
                "sha256"
              ],
              "properties": {
                "uri": {
                  "type": "string",
                  "format": "uri",
                  "x-holdback-untrusted": true,
                  "maxLength": 2048
                },
                "sha256": {
                  "$ref": "common.schema.json#/$defs/Sha256"
                }
              }
            },
            "keyColumn": {
              "type": "string",
              "x-holdback-untrusted": true,
              "maxLength": 128
            },
            "minBps": {
              "$ref": "common.schema.json#/$defs/Bps",
              "description": "Least share of rows that must match, in basis points"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "required",
            "max"
          ],
          "description": "Counts invisible characters in the raw delivered bytes, before any normalization, and fails when a count exceeds its maximum (ADR-0021)",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9_-]{1,40}$"
            },
            "required": {
              "type": "boolean"
            },
            "type": {
              "const": "hidden_characters_max"
            },
            "max": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "description": "At least one maximum. Classes: Unicode tag characters (U+E0000 to U+E007F), bidirectional controls, variation selectors, and other default-ignorable or zero-width code points. total bounds their sum.",
              "properties": {
                "tag": {
                  "type": "integer",
                  "minimum": 0
                },
                "bidi": {
                  "type": "integer",
                  "minimum": 0
                },
                "variationSelector": {
                  "type": "integer",
                  "minimum": 0
                },
                "otherIgnorable": {
                  "type": "integer",
                  "minimum": 0
                },
                "total": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      ]
    },
    "Criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "weight",
        "anchors"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]{1,40}$"
        },
        "description": {
          "type": "string",
          "maxLength": 500,
          "x-holdback-untrusted": true
        },
        "weight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "description": "Relative weight among the rubric's criteria (an integer; only ratios matter)"
        },
        "anchors": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "0",
            "2",
            "4"
          ],
          "properties": {
            "0": {
              "type": "string",
              "maxLength": 300,
              "x-holdback-untrusted": true
            },
            "1": {
              "type": "string",
              "maxLength": 300,
              "x-holdback-untrusted": true
            },
            "2": {
              "type": "string",
              "maxLength": 300,
              "x-holdback-untrusted": true
            },
            "3": {
              "type": "string",
              "maxLength": 300,
              "x-holdback-untrusted": true
            },
            "4": {
              "type": "string",
              "maxLength": 300,
              "x-holdback-untrusted": true
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "settlement": {
            "properties": {
              "mode": {
                "const": "optimistic"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "then": {
        "properties": {
          "timing": {
            "required": [
              "disputeBy",
              "disputeJudgeSec",
              "disputeFallbackSec"
            ],
            "type": "object",
            "properties": {
              "disputeBy": {},
              "disputeJudgeSec": {},
              "disputeFallbackSec": {}
            }
          }
        },
        "type": "object"
      },
      "else": {
        "properties": {
          "timing": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "disputeBy"
                  ],
                  "type": "object",
                  "properties": {
                    "disputeBy": {}
                  }
                },
                {
                  "required": [
                    "disputeJudgeSec"
                  ],
                  "type": "object",
                  "properties": {
                    "disputeJudgeSec": {}
                  }
                },
                {
                  "required": [
                    "disputeFallbackSec"
                  ],
                  "type": "object",
                  "properties": {
                    "disputeFallbackSec": {}
                  }
                }
              ]
            }
          }
        },
        "type": "object"
      }
    }
  ]
}
