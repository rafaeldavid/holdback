{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://holdback.dev/schemas/v0.11/delivery.schema.json",
  "title": "Delivery (encrypted work + escrowed key)",
  "type": "object",
  "required": [
    "commitmentId",
    "attempt",
    "ciphertext",
    "plaintextSha256",
    "plaintextMime",
    "encryptedKeys",
    "submittedAt",
    "signature"
  ],
  "additionalProperties": false,
  "properties": {
    "commitmentId": {
      "$ref": "common.schema.json#/$defs/Hex32"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "ciphertext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "sha256",
        "bytes",
        "cipher"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri",
          "x-holdback-untrusted": true,
          "maxLength": 2048
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/Sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10485760
        },
        "cipher": {
          "const": "aes-256-gcm"
        }
      }
    },
    "plaintextSha256": {
      "$ref": "common.schema.json#/$defs/Sha256"
    },
    "plaintextMime": {
      "enum": [
        "text/csv",
        "application/json",
        "text/plain",
        "text/markdown"
      ]
    },
    "encryptedKeys": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "common.schema.json#/$defs/EncryptedKey"
      },
      "description": "The content key encrypted to the primary, fallback and appeal adjudicators, and to the buyer for early acceptance (ADR-0012, ADR-0016)"
    },
    "submittedAt": {
      "$ref": "common.schema.json#/$defs/Timestamp"
    },
    "signature": {
      "$ref": "common.schema.json#/$defs/Signature"
    }
  }
}
