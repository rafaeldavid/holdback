{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://holdback.dev/schemas/v0.8/club.schema.json",
  "title": "Club and rulebook",
  "type": "object",
  "required": [
    "id",
    "name",
    "operator",
    "rulebook",
    "rulebookHash"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]{3,64}$"
    },
    "name": {
      "type": "string",
      "maxLength": 120,
      "x-holdback-untrusted": true
    },
    "operator": {
      "$ref": "common.schema.json#/$defs/Address"
    },
    "rulebook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "open",
        "minWindowsSec",
        "windowCoverageRatioBps",
        "appealBondRateBps",
        "sealedChecksMaxWeightBps",
        "maxSubmissions",
        "defaultOutcome",
        "allowedSettlementModes",
        "allowedTokens",
        "panelPolicyMin",
        "appealFee",
        "firstLossShareMinBps",
        "bondNoticePeriodMinSec",
        "randomness",
        "minInspectionWindowSec",
        "disputeBond",
        "mutualSettlement",
        "disclosureMin",
        "identityModes"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "open": {
          "type": "boolean",
          "description": "If true, no membership is required"
        },
        "documentUri": {
          "type": "string",
          "format": "uri",
          "x-holdback-untrusted": true,
          "maxLength": 2048
        },
        "minWindowsSec": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "judge",
            "fallback",
            "appealWindow",
            "appealDecide"
          ],
          "properties": {
            "judge": {
              "type": "integer",
              "minimum": 1
            },
            "fallback": {
              "type": "integer",
              "minimum": 1
            },
            "appealWindow": {
              "type": "integer",
              "minimum": 1
            },
            "appealDecide": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "windowCoverageRatioBps": {
          "$ref": "common.schema.json#/$defs/Bps",
          "description": "Minimum bond share of open exposure for settle_after_window commitments; guaranteed commitments always need 100% (ADR-0007)"
        },
        "appealBondRateBps": {
          "$ref": "common.schema.json#/$defs/Bps"
        },
        "sealedChecksMaxWeightBps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3000,
          "description": "Most weight sealed checks may carry, in basis points (at most 3000)"
        },
        "maxSubmissions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "defaultOutcome": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "judged"
          ],
          "description": "Per settlement mode (ADR-0015). judged applies to guaranteed_on_decision and settle_after_window.",
          "properties": {
            "judged": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "refundBuyer",
                "sellerCompensationRateBps"
              ],
              "properties": {
                "refundBuyer": {
                  "const": true
                },
                "sellerCompensationRateBps": {
                  "$ref": "common.schema.json#/$defs/Bps"
                }
              }
            },
            "optimistic": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "release",
                "buyerCompensationRateBps"
              ],
              "properties": {
                "release": {
                  "const": true,
                  "description": "Silence resolves to release to the seller, the tacit-acceptance baseline"
                },
                "buyerCompensationRateBps": {
                  "$ref": "common.schema.json#/$defs/Bps",
                  "description": "Paid to the buyer from a defaulting adjudicator's reserved bond, in basis points of price"
                }
              }
            }
          }
        },
        "allowedSettlementModes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/SettlementMode"
          }
        },
        "allowedTokens": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/TokenId"
          }
        },
        "panelPolicyMin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "panelSize",
            "appealPanelSize",
            "minFamilies"
          ],
          "properties": {
            "panelSize": {
              "type": "integer",
              "minimum": 3
            },
            "appealPanelSize": {
              "type": "integer",
              "minimum": 5
            },
            "minFamilies": {
              "type": "integer",
              "minimum": 2
            }
          }
        },
        "appealFee": {
          "$ref": "common.schema.json#/$defs/TokenAmount",
          "description": "Paid by an appellant to the appeal adjudicator"
        },
        "firstLossShareMinBps": {
          "$ref": "common.schema.json#/$defs/Bps",
          "description": "Minimum junior share of an adjudicator's pool, in basis points (ADR-0014); default 1000"
        },
        "bondNoticePeriodMinSec": {
          "type": "integer",
          "minimum": 0,
          "description": "Minimum withdrawal notice for backers; default one appeal cycle"
        },
        "randomness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source"
          ],
          "description": "Panel seed source for fallback and appeal decisions (ADR-0018)",
          "properties": {
            "source": {
              "$ref": "common.schema.json#/$defs/RandomnessSource"
            },
            "chainHash": {
              "$ref": "common.schema.json#/$defs/Hex32",
              "description": "drand chain hash; required for drand-quicknet"
            }
          },
          "if": {
            "properties": {
              "source": {
                "const": "drand-quicknet"
              }
            },
            "type": "object"
          },
          "then": {
            "required": [
              "chainHash"
            ],
            "type": "object",
            "properties": {
              "chainHash": {}
            }
          }
        },
        "minInspectionWindowSec": {
          "type": "integer",
          "minimum": 0,
          "description": "Optimistic mode: deliverBy plus this is at most disputeBy"
        },
        "disputeBond": {
          "$ref": "common.schema.json#/$defs/TokenAmount",
          "description": "Optimistic mode: posted by a disputing buyer, paid to the seller if the dispute fails"
        },
        "mutualSettlement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowed",
            "adjudicatorFeeShareAfterDeliveryBps",
            "payoutsTo"
          ],
          "description": "Whether buyer and seller may close a commitment by co-signed agreement (ADR-0019)",
          "properties": {
            "allowed": {
              "type": "boolean"
            },
            "adjudicatorFeeShareAfterDeliveryBps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000,
              "description": "Share of the held adjudicator fee paid to the sitting adjudicator when the parties settle after delivery, in basis points (10000 = all); before delivery the fee returns to the buyer. Phase 1 requires 0 (ADR-0019)."
            },
            "payoutsTo": {
              "enum": [
                "parties",
                "any"
              ],
              "description": "parties: payouts may name only the buyer and the seller. any: any addresses both parties sign for, such as another escrow or an outside arbiter (D23). A regulated club sets parties."
            }
          }
        },
        "disclosureMin": {
          "$ref": "common.schema.json#/$defs/DisclosureLevel",
          "description": "Lowest disclosure level a commitment under this rulebook may choose (ADR-0020)"
        },
        "identityModes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "long-term",
              "pseudonymous"
            ]
          },
          "description": "Signing identities parties may use: one long-term key, or a pseudonymous one-time key per commitment derived from a long-term meta-address (ADR-0020 §7). Phase 1 admits long-term only."
        }
      },
      "if": {
        "properties": {
          "allowedSettlementModes": {
            "contains": {
              "const": "optimistic"
            },
            "type": "array"
          }
        },
        "required": [
          "allowedSettlementModes"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "defaultOutcome": {
            "required": [
              "optimistic"
            ],
            "type": "object",
            "properties": {
              "optimistic": {}
            }
          }
        },
        "type": "object"
      }
    },
    "rulebookHash": {
      "$ref": "common.schema.json#/$defs/Hex32",
      "description": "keccak256 of the RFC 8785 canonical JSON of rulebook"
    }
  }
}
