{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://holdback.dev/schemas/v0.5/club.schema.json",
  "title": "Club and rulebook",
  "type": "object",
  "required": [
    "id",
    "name",
    "operator",
    "rulebook",
    "rulebookHash"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]{3,64}$"
    },
    "name": {
      "type": "string",
      "maxLength": 120,
      "x-holdback-untrusted": true
    },
    "operator": {
      "$ref": "common.schema.json#/$defs/Address"
    },
    "rulebook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "open",
        "minWindowsSec",
        "windowCoverageRatio",
        "appealBondRate",
        "sealedChecksMaxWeight",
        "maxSubmissions",
        "defaultOutcome",
        "allowedSettlementModes",
        "allowedTokens",
        "panelPolicyMin",
        "appealFee",
        "firstLossShareMin",
        "bondNoticePeriodMinSec",
        "randomness",
        "minInspectionWindowSec",
        "disputeBond"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "open": {
          "type": "boolean",
          "description": "If true, no membership is required"
        },
        "documentUri": {
          "type": "string",
          "format": "uri"
        },
        "minWindowsSec": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "judge",
            "fallback",
            "appealWindow",
            "appealDecide"
          ],
          "properties": {
            "judge": {
              "type": "integer",
              "minimum": 1
            },
            "fallback": {
              "type": "integer",
              "minimum": 1
            },
            "appealWindow": {
              "type": "integer",
              "minimum": 1
            },
            "appealDecide": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "windowCoverageRatio": {
          "$ref": "common.schema.json#/$defs/Rate",
          "description": "Minimum bond share of open exposure for settle_after_window commitments; guaranteed commitments always need 100% (ADR-0007)"
        },
        "appealBondRate": {
          "$ref": "common.schema.json#/$defs/Rate"
        },
        "sealedChecksMaxWeight": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.3
        },
        "maxSubmissions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "defaultOutcome": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "judged"
          ],
          "description": "Per settlement mode (ADR-0015). judged applies to guaranteed_on_decision and settle_after_window.",
          "properties": {
            "judged": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "refundBuyer",
                "sellerCompensationRate"
              ],
              "properties": {
                "refundBuyer": {
                  "const": true
                },
                "sellerCompensationRate": {
                  "$ref": "common.schema.json#/$defs/Rate"
                }
              }
            },
            "optimistic": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "release",
                "buyerCompensationRate"
              ],
              "properties": {
                "release": {
                  "const": true,
                  "description": "Silence resolves to release to the seller, the tacit-acceptance baseline"
                },
                "buyerCompensationRate": {
                  "$ref": "common.schema.json#/$defs/Rate",
                  "description": "Paid to the buyer from a defaulting adjudicator's reserved bond"
                }
              }
            }
          }
        },
        "allowedSettlementModes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/SettlementMode"
          }
        },
        "allowedTokens": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "panelPolicyMin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "panelSize",
            "appealPanelSize",
            "minFamilies"
          ],
          "properties": {
            "panelSize": {
              "type": "integer",
              "minimum": 3
            },
            "appealPanelSize": {
              "type": "integer",
              "minimum": 5
            },
            "minFamilies": {
              "type": "integer",
              "minimum": 2
            }
          }
        },
        "appealFee": {
          "$ref": "common.schema.json#/$defs/TokenAmount",
          "description": "Paid by an appellant to the appeal adjudicator"
        },
        "firstLossShareMin": {
          "$ref": "common.schema.json#/$defs/Rate",
          "description": "Minimum junior share of an adjudicator's pool (ADR-0014); default 0.1"
        },
        "bondNoticePeriodMinSec": {
          "type": "integer",
          "minimum": 0,
          "description": "Minimum withdrawal notice for backers; default one appeal cycle"
        },
        "randomness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source"
          ],
          "description": "Panel seed source for fallback and appeal decisions (ADR-0018)",
          "properties": {
            "source": {
              "$ref": "common.schema.json#/$defs/RandomnessSource"
            },
            "chainHash": {
              "$ref": "common.schema.json#/$defs/Hex32",
              "description": "drand chain hash; required for drand-quicknet"
            }
          },
          "if": {
            "properties": {
              "source": {
                "const": "drand-quicknet"
              }
            },
            "type": "object"
          },
          "then": {
            "required": [
              "chainHash"
            ],
            "type": "object",
            "properties": {
              "chainHash": {}
            }
          }
        },
        "minInspectionWindowSec": {
          "type": "integer",
          "minimum": 0,
          "description": "Optimistic mode: deliverBy plus this is at most disputeBy"
        },
        "disputeBond": {
          "$ref": "common.schema.json#/$defs/TokenAmount",
          "description": "Optimistic mode: posted by a disputing buyer, paid to the seller if the dispute fails"
        }
      },
      "if": {
        "properties": {
          "allowedSettlementModes": {
            "contains": {
              "const": "optimistic"
            },
            "type": "array"
          }
        },
        "required": [
          "allowedSettlementModes"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "defaultOutcome": {
            "required": [
              "optimistic"
            ],
            "type": "object",
            "properties": {
              "optimistic": {}
            }
          }
        },
        "type": "object"
      }
    },
    "rulebookHash": {
      "$ref": "common.schema.json#/$defs/Hex32",
      "description": "keccak256 of the RFC 8785 canonical JSON of rulebook"
    }
  }
}
