{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://holdback.dev/schemas/v0.10/agent.schema.json",
  "title": "Agent registration",
  "type": "object",
  "required": [
    "address",
    "clubId",
    "memberId",
    "principal",
    "scope",
    "mandateHash",
    "status",
    "registeredAt"
  ],
  "additionalProperties": false,
  "properties": {
    "address": {
      "$ref": "common.schema.json#/$defs/Address"
    },
    "clubId": {
      "$ref": "common.schema.json#/$defs/ClubId"
    },
    "memberId": {
      "type": "string",
      "maxLength": 120,
      "x-holdback-untrusted": true
    },
    "principal": {
      "$ref": "common.schema.json#/$defs/Address"
    },
    "scope": {
      "$ref": "common.schema.json#/$defs/Scope"
    },
    "encryptionPublicKey": {
      "$ref": "common.schema.json#/$defs/Base64Url",
      "description": "X25519 public key for receiving content keys"
    },
    "mandateHash": {
      "$ref": "common.schema.json#/$defs/Hex32"
    },
    "status": {
      "enum": [
        "active",
        "revoked"
      ]
    },
    "registeredAt": {
      "$ref": "common.schema.json#/$defs/Timestamp"
    }
  }
}
