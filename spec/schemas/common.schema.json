{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://holdback.dev/schemas/v0.3/common.schema.json",
  "title": "Common definitions",
  "$defs": {
    "Address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "Hex32": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$",
      "description": "32-byte value (keccak256 hash, EIP-712 struct hash, seed, nonce)"
    },
    "Signature": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{130}$",
      "description": "65-byte secp256k1 signature over EIP-712 typed data"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 of artifact bytes"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "Base64Url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "TokenAmount": {
      "type": "object",
      "required": [
        "token",
        "amount"
      ],
      "additionalProperties": false,
      "properties": {
        "token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Token identifier, e.g. tUSD on SimChain or an ERC-20 address on a chain"
        },
        "amount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,77})$",
          "description": "Base units as a decimal string"
        }
      }
    },
    "Rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "SettlementMode": {
      "enum": [
        "guaranteed_on_decision",
        "settle_after_window"
      ]
    },
    "Scope": {
      "type": "object",
      "required": [
        "roles",
        "maxPerCommitment",
        "maxDaily",
        "expiresAt"
      ],
      "additionalProperties": false,
      "properties": {
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "buyer",
              "seller"
            ]
          }
        },
        "maxPerCommitment": {
          "$ref": "#/$defs/TokenAmount"
        },
        "maxDaily": {
          "$ref": "#/$defs/TokenAmount"
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          }
        },
        "expiresAt": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    }
  }
}
