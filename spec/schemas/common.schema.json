{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://holdback.dev/schemas/v0.5/common.schema.json",
  "title": "Common definitions",
  "$defs": {
    "Address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "Hex32": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$",
      "description": "32-byte value (keccak256 hash, EIP-712 struct hash, seed, nonce)"
    },
    "Signature": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{130}$",
      "description": "65-byte secp256k1 signature over EIP-712 typed data"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 of artifact bytes"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "Base64Url": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "TokenAmount": {
      "type": "object",
      "required": [
        "token",
        "amount"
      ],
      "additionalProperties": false,
      "properties": {
        "token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Token identifier, e.g. tUSD on SimChain or an ERC-20 address on a chain"
        },
        "amount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,77})$",
          "description": "Base units as a decimal string"
        }
      }
    },
    "Rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "SettlementMode": {
      "enum": [
        "guaranteed_on_decision",
        "settle_after_window",
        "optimistic"
      ]
    },
    "Scope": {
      "type": "object",
      "required": [
        "roles",
        "maxPerCommitment",
        "maxDaily",
        "expiresAt"
      ],
      "additionalProperties": false,
      "properties": {
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "buyer",
              "seller"
            ]
          }
        },
        "maxPerCommitment": {
          "$ref": "#/$defs/TokenAmount"
        },
        "maxDaily": {
          "$ref": "#/$defs/TokenAmount"
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          }
        },
        "expiresAt": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "RandomnessSource": {
      "enum": [
        "sim",
        "drand-quicknet",
        "prevrandao"
      ],
      "description": "Where fallback and appeal panel seeds come from (ADR-0018). Phase 1 admits sim only."
    },
    "DisclosureLevel": {
      "enum": [
        "private",
        "judgment",
        "public"
      ],
      "description": "Who may read a commitment's terms and records (ADR-0020). Phase 1 admits public only."
    },
    "KeyUnlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "description": "When a recipient may open an encrypted key: at once, or once a beacon round is published (ADR-0020)",
      "properties": {
        "kind": {
          "enum": [
            "none",
            "beacon-round"
          ]
        },
        "round": {
          "type": "integer",
          "minimum": 0
        }
      },
      "if": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "beacon-round"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "type": "object",
        "required": [
          "round"
        ],
        "properties": {
          "round": {}
        }
      },
      "else": {
        "type": "object",
        "not": {
          "type": "object",
          "required": [
            "round"
          ],
          "properties": {
            "round": {}
          }
        }
      }
    },
    "EncryptedKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipient",
        "scheme",
        "ciphertext"
      ],
      "properties": {
        "recipient": {
          "$ref": "#/$defs/Address"
        },
        "scheme": {
          "const": "x25519-xsalsa20poly1305"
        },
        "ciphertext": {
          "$ref": "#/$defs/Base64Url"
        },
        "unlock": {
          "$ref": "#/$defs/KeyUnlock"
        }
      }
    },
    "PrivateBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hash",
        "envelopes"
      ],
      "description": "A body kept off the public record: its keccak256 and the key envelopes for the parties allowed to read it (ADR-0020)",
      "properties": {
        "hash": {
          "$ref": "#/$defs/Hex32"
        },
        "envelopes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/EncryptedKey"
          }
        }
      }
    }
  }
}
