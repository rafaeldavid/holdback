{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://holdback.dev/schemas/v0.5/event.schema.json",
  "title": "Settlement event (hash-chained)",
  "type": "object",
  "required": [
    "seq",
    "type",
    "at",
    "payload",
    "prevHash",
    "hash"
  ],
  "additionalProperties": false,
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "type": {
      "enum": [
        "club.registered",
        "agent.registered",
        "agent.revoked",
        "adjudicator.registered",
        "commitment.offered",
        "adjudicator.accepted",
        "member.admitted",
        "member.revoked",
        "commitment.agreed",
        "offer.expired",
        "hold.funded",
        "delivery.submitted",
        "judgment.decided",
        "fallback.triggered",
        "default.triggered",
        "appeal.filed",
        "appeal.decided",
        "appeal.expired",
        "settlement.released",
        "settlement.refunded",
        "settlement.reclaimed",
        "key.released",
        "bond.paid",
        "bond.deposited",
        "bond.withdrawn",
        "bond.slashed",
        "dispute.opened",
        "commitment.settled"
      ]
    },
    "commitmentId": {
      "$ref": "common.schema.json#/$defs/Hex32"
    },
    "at": {
      "$ref": "common.schema.json#/$defs/Timestamp"
    },
    "actor": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/Address"
        },
        {
          "const": "anyone"
        }
      ]
    },
    "submittedVia": {
      "type": "string",
      "description": "Operator id or 'direct'"
    },
    "payload": {
      "type": "object"
    },
    "prevHash": {
      "$ref": "common.schema.json#/$defs/Hex32"
    },
    "hash": {
      "$ref": "common.schema.json#/$defs/Hex32"
    }
  },
  "$defs": {
    "BondMovement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adjudicator",
        "junior",
        "senior"
      ],
      "description": "Per-tranche amounts moved in or out of an adjudicator's pool (ADR-0014)",
      "properties": {
        "adjudicator": {
          "$ref": "common.schema.json#/$defs/Address"
        },
        "backer": {
          "$ref": "common.schema.json#/$defs/Address"
        },
        "junior": {
          "$ref": "common.schema.json#/$defs/TokenAmount"
        },
        "senior": {
          "$ref": "common.schema.json#/$defs/TokenAmount"
        },
        "reason": {
          "enum": [
            "deposit",
            "withdrawal",
            "overturn",
            "default",
            "appeal-upheld"
          ]
        }
      }
    },
    "SettledSplit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sellerAmount",
        "buyerAmount",
        "keyReleased"
      ],
      "properties": {
        "sellerAmount": {
          "$ref": "common.schema.json#/$defs/TokenAmount"
        },
        "buyerAmount": {
          "$ref": "common.schema.json#/$defs/TokenAmount"
        },
        "keyReleased": {
          "type": "boolean"
        }
      },
      "description": "The split a mutual settlement applied (ADR-0019)"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "bond.deposited",
              "bond.withdrawn",
              "bond.slashed"
            ]
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/BondMovement"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": {
            "const": "commitment.settled"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "payload": {
            "$ref": "#/$defs/SettledSplit"
          }
        }
      }
    }
  ]
}
