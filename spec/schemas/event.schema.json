{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://holdback.dev/schemas/v0.9/event.schema.json",
  "title": "Settlement event (hash-chained)",
  "type": "object",
  "required": [
    "seq",
    "type",
    "at",
    "payload",
    "prevHash",
    "hash"
  ],
  "additionalProperties": false,
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "type": {
      "enum": [
        "club.registered",
        "agent.registered",
        "agent.revoked",
        "adjudicator.registered",
        "commitment.offered",
        "adjudicator.accepted",
        "member.admitted",
        "member.revoked",
        "commitment.agreed",
        "offer.expired",
        "hold.funded",
        "delivery.submitted",
        "judgment.decided",
        "fallback.triggered",
        "default.triggered",
        "appeal.filed",
        "appeal.decided",
        "appeal.expired",
        "settlement.released",
        "settlement.refunded",
        "settlement.reclaimed",
        "key.released",
        "bond.paid",
        "bond.deposited",
        "bond.withdrawn",
        "bond.slashed",
        "dispute.opened",
        "commitment.settled",
        "fee.operator"
      ]
    },
    "commitmentId": {
      "$ref": "common.schema.json#/$defs/Hex32"
    },
    "at": {
      "$ref": "common.schema.json#/$defs/Timestamp"
    },
    "actor": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/Address"
        },
        {
          "const": "anyone"
        }
      ]
    },
    "submittedVia": {
      "type": "string",
      "description": "Operator id or 'direct'",
      "x-holdback-untrusted": true,
      "maxLength": 64
    },
    "payload": {
      "type": "object",
      "description": "Event body. Offered and agreed events always carry termsHash, judgment and appeal decisions always carry recordHash; the bodies themselves are present only as the disclosure level allows (ADR-0020)"
    },
    "prevHash": {
      "$ref": "common.schema.json#/$defs/Hex32"
    },
    "hash": {
      "$ref": "common.schema.json#/$defs/Hex32"
    }
  },
  "$defs": {
    "ChainTx": {
      "type": "object",
      "description": "The chain transaction a settlement event came from. An EVM settlement adds these to the payload of every event it reads from a block; SimChain has no transactions and omits them (v0.9)",
      "properties": {
        "tx": {
          "$ref": "common.schema.json#/$defs/Hex32",
          "description": "Transaction hash"
        },
        "block": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "description": "Block number, decimal"
        },
        "sender": {
          "$ref": "common.schema.json#/$defs/Address",
          "description": "The account that sent the transaction (a relayer or a party); never the authority for what the event records"
        },
        "gasUsed": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "description": "Gas the transaction used, decimal"
        }
      }
    },
    "BondMovement": {
      "type": "object",
      "$ref": "#/$defs/ChainTx",
      "unevaluatedProperties": false,
      "required": [
        "adjudicator",
        "junior",
        "senior"
      ],
      "description": "Per-tranche amounts moved in or out of an adjudicator's pool (ADR-0014)",
      "properties": {
        "adjudicator": {
          "$ref": "common.schema.json#/$defs/Address"
        },
        "backer": {
          "$ref": "common.schema.json#/$defs/Address"
        },
        "junior": {
          "$ref": "common.schema.json#/$defs/TokenAmount"
        },
        "senior": {
          "$ref": "common.schema.json#/$defs/TokenAmount"
        },
        "reason": {
          "enum": [
            "deposit",
            "withdrawal",
            "overturn",
            "default",
            "appeal-upheld"
          ]
        }
      }
    },
    "SettledSplit": {
      "type": "object",
      "$ref": "#/$defs/ChainTx",
      "unevaluatedProperties": false,
      "required": [
        "payouts",
        "keyReleased"
      ],
      "properties": {
        "payouts": {
          "$ref": "common.schema.json#/$defs/Payouts"
        },
        "keyReleased": {
          "type": "boolean"
        }
      },
      "description": "The payouts a mutual settlement applied (ADR-0019, D23)"
    },
    "OperatorFeePaid": {
      "type": "object",
      "$ref": "#/$defs/ChainTx",
      "unevaluatedProperties": false,
      "required": [
        "from",
        "to",
        "amount"
      ],
      "description": "ADR-0023: the buyer's operator fee, moved from the buyer to the operator's fee address with the funded agreement, outside the hold; never refunded",
      "properties": {
        "from": {
          "$ref": "common.schema.json#/$defs/Address"
        },
        "to": {
          "$ref": "common.schema.json#/$defs/Address"
        },
        "amount": {
          "$ref": "common.schema.json#/$defs/TokenAmount"
        },
        "postings": {
          "type": "array",
          "description": "The ledger postings that moved it, as every settlement event lists them",
          "items": {
            "type": "object"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "type": {
            "const": "fee.operator"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "payload": {
            "$ref": "#/$defs/OperatorFeePaid"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "bond.deposited",
              "bond.withdrawn",
              "bond.slashed"
            ]
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/BondMovement"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": {
            "const": "commitment.settled"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "payload": {
            "$ref": "#/$defs/SettledSplit"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "commitment.offered",
              "commitment.agreed"
            ]
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "termsHash"
            ],
            "properties": {
              "termsHash": {
                "$ref": "common.schema.json#/$defs/Hex32"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "judgment.decided",
              "appeal.decided"
            ]
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "recordHash"
            ],
            "properties": {
              "recordHash": {
                "$ref": "common.schema.json#/$defs/Hex32"
              }
            }
          }
        }
      }
    }
  ]
}
