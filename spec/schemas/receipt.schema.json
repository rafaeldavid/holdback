{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://holdback.dev/schemas/v0.6/receipt.schema.json",
  "title": "Operator receipt (ADR-0017)",
  "description": "An operator's EIP-712 signature over an event it relayed or indexed. Verify it with the receipt signer from GET /v1/status and the event hash chain.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operator",
    "eventSeq",
    "eventHash",
    "signature"
  ],
  "properties": {
    "operator": {
      "$ref": "common.schema.json#/$defs/Address",
      "description": "The operator's receipt-signing address"
    },
    "eventSeq": {
      "type": "integer",
      "minimum": 0
    },
    "eventHash": {
      "$ref": "common.schema.json#/$defs/Hex32"
    },
    "commitmentId": {
      "$ref": "common.schema.json#/$defs/Hex32",
      "description": "Absent for events with no commitment, such as bond deposits"
    },
    "signature": {
      "$ref": "common.schema.json#/$defs/Signature"
    }
  }
}
