{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://holdback.dev/schemas/v0.2/commitment-state.schema.json",
  "title": "Commitment state (read model)",
  "type": "object",
  "required": [
    "commitmentId",
    "state",
    "attempt",
    "deadlines",
    "lastEventSeq",
    "updatedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "commitmentId": {
      "$ref": "common.schema.json#/$defs/Hex32"
    },
    "state": {
      "enum": [
        "Offered",
        "Agreed",
        "Held",
        "Delivered",
        "Judging",
        "FallbackJudging",
        "Escalated",
        "Accepted",
        "Rejected",
        "Appealed",
        "Released",
        "Refunded",
        "Defaulted",
        "Expired",
        "Final"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "hold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "railRef"
      ],
      "properties": {
        "amount": {
          "$ref": "common.schema.json#/$defs/TokenAmount"
        },
        "railRef": {
          "type": "string"
        }
      }
    },
    "deadlines": {
      "type": "object",
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/Timestamp"
      }
    },
    "balances": {
      "type": "object",
      "propertyNames": {
        "pattern": "^0x[0-9a-fA-F]{40}$"
      },
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/TokenAmount"
      }
    },
    "lastEventSeq": {
      "type": "integer",
      "minimum": 0
    },
    "updatedAt": {
      "$ref": "common.schema.json#/$defs/Timestamp"
    }
  }
}
