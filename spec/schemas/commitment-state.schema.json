{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://holdback.dev/schemas/v0.6/commitment-state.schema.json",
  "title": "Commitment state (read model)",
  "type": "object",
  "required": [
    "commitmentId",
    "escrowState",
    "appealState",
    "attempt",
    "deadlines",
    "lastEventSeq",
    "updatedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "commitmentId": {
      "$ref": "common.schema.json#/$defs/Hex32"
    },
    "escrowState": {
      "enum": [
        "Offered",
        "AcceptedByAdjudicator",
        "Agreed",
        "Held",
        "Delivered",
        "Disputed",
        "FallbackJudging",
        "Escalated",
        "Released",
        "Refunded",
        "Settled",
        "Defaulted",
        "Expired"
      ],
      "description": "Where the money is (ADR-0016)"
    },
    "appealState": {
      "enum": [
        "none",
        "open",
        "upheld",
        "overturned",
        "expired"
      ],
      "description": "Defined after a first-instance decision; an overturn moves bond money, not escrow money"
    },
    "attempt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "hold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "railRef"
      ],
      "properties": {
        "amount": {
          "$ref": "common.schema.json#/$defs/TokenAmount"
        },
        "railRef": {
          "type": "string",
          "x-holdback-untrusted": true,
          "maxLength": 200
        }
      }
    },
    "deadlines": {
      "type": "object",
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/Timestamp"
      }
    },
    "balances": {
      "type": "object",
      "propertyNames": {
        "pattern": "^0x[0-9a-fA-F]{40}$"
      },
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/TokenAmount"
      }
    },
    "settledAt": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        {
          "type": "null"
        }
      ],
      "description": "When money moved to its payee; irrevocable for that payee (D20). Null or absent before then. Not signed."
    },
    "finalAt": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        {
          "type": "null"
        }
      ],
      "description": "When no protocol step can change who got what, for example after the appeal window closes (D20). Null until that is true. Not signed."
    },
    "lastEventSeq": {
      "type": "integer",
      "minimum": 0
    },
    "updatedAt": {
      "$ref": "common.schema.json#/$defs/Timestamp"
    },
    "settled": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payouts",
        "keyReleased"
      ],
      "properties": {
        "payouts": {
          "$ref": "common.schema.json#/$defs/Payouts"
        },
        "keyReleased": {
          "type": "boolean"
        }
      },
      "description": "What a mutual settlement paid, present only once one closed the commitment (ADR-0019, D23). The adjudication fee returned to the buyer is derived from the terms, not repeated here."
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "escrowState": {
            "const": "Settled"
          }
        },
        "required": [
          "escrowState"
        ]
      },
      "then": {
        "type": "object",
        "required": [
          "settled"
        ],
        "properties": {
          "settled": {}
        }
      },
      "else": {
        "type": "object",
        "not": {
          "type": "object",
          "required": [
            "settled"
          ],
          "properties": {
            "settled": {}
          }
        }
      }
    }
  ]
}
