{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://holdback.dev/schemas/v0.5/messages.schema.json",
  "title": "Signed protocol messages (EIP-712)",
  "description": "Every state-changing message other than Delivery and Appeal. Each carries its EIP-712 domain implicitly: name Holdback, version 0.5, chainId, verifyingContract (ADR-0016).",
  "oneOf": [
    {
      "$ref": "#/$defs/Offer"
    },
    {
      "$ref": "#/$defs/Agree"
    },
    {
      "$ref": "#/$defs/AdjudicatorAcceptance"
    },
    {
      "$ref": "#/$defs/FundingAuthorization"
    },
    {
      "$ref": "#/$defs/EarlyAccept"
    },
    {
      "$ref": "#/$defs/Decision"
    },
    {
      "$ref": "#/$defs/AgentRevocation"
    },
    {
      "$ref": "#/$defs/MemberAdmission"
    },
    {
      "$ref": "#/$defs/MemberRevocation"
    },
    {
      "$ref": "#/$defs/Dispute"
    },
    {
      "$ref": "#/$defs/MutualSettlement"
    },
    {
      "$ref": "#/$defs/Publish"
    }
  ],
  "$defs": {
    "Offer": {
      "type": "object",
      "description": "Seller's signature over the commitment terms",
      "additionalProperties": false,
      "required": [
        "type",
        "commitmentId",
        "seller",
        "nonce",
        "expiresAt",
        "signature"
      ],
      "properties": {
        "type": {
          "const": "Offer"
        },
        "commitmentId": {
          "$ref": "common.schema.json#/$defs/Hex32"
        },
        "seller": {
          "$ref": "common.schema.json#/$defs/Address"
        },
        "nonce": {
          "$ref": "common.schema.json#/$defs/Hex32"
        },
        "expiresAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "signature": {
          "$ref": "common.schema.json#/$defs/Signature"
        }
      }
    },
    "Agree": {
      "type": "object",
      "description": "Buyer's signature over the identical terms",
      "additionalProperties": false,
      "required": [
        "type",
        "commitmentId",
        "buyer",
        "nonce",
        "expiresAt",
        "signature"
      ],
      "properties": {
        "type": {
          "const": "Agree"
        },
        "commitmentId": {
          "$ref": "common.schema.json#/$defs/Hex32"
        },
        "buyer": {
          "$ref": "common.schema.json#/$defs/Address"
        },
        "nonce": {
          "$ref": "common.schema.json#/$defs/Hex32"
        },
        "expiresAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "signature": {
          "$ref": "common.schema.json#/$defs/Signature"
        }
      }
    },
    "AdjudicatorAcceptance": {
      "type": "object",
      "description": "Primary adjudicator consents and reserves bond before funding (ADR-0016)",
      "additionalProperties": false,
      "required": [
        "type",
        "commitmentId",
        "adjudicator",
        "seedCommitment",
        "policyHash",
        "registryHash",
        "fee",
        "bondReserved",
        "nonce",
        "expiresAt",
        "signature"
      ],
      "properties": {
        "type": {
          "const": "AdjudicatorAcceptance"
        },
        "commitmentId": {
          "$ref": "common.schema.json#/$defs/Hex32"
        },
        "adjudicator": {
          "$ref": "common.schema.json#/$defs/Address"
        },
        "seedCommitment": {
          "$ref": "common.schema.json#/$defs/Hex32",
          "description": "keccak256(seed); the seed is revealed in the Decision"
        },
        "policyHash": {
          "$ref": "common.schema.json#/$defs/Hex32"
        },
        "registryHash": {
          "$ref": "common.schema.json#/$defs/Hex32"
        },
        "fee": {
          "$ref": "common.schema.json#/$defs/TokenAmount"
        },
        "bondReserved": {
          "$ref": "common.schema.json#/$defs/TokenAmount"
        },
        "nonce": {
          "$ref": "common.schema.json#/$defs/Hex32"
        },
        "expiresAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "signature": {
          "$ref": "common.schema.json#/$defs/Signature"
        }
      }
    },
    "FundingAuthorization": {
      "type": "object",
      "description": "Buyer's transfer authorization; any relayer may submit it",
      "additionalProperties": false,
      "required": [
        "type",
        "scheme",
        "commitmentId",
        "from",
        "value",
        "token",
        "validAfter",
        "validBefore",
        "nonce",
        "expiresAt",
        "signature"
      ],
      "properties": {
        "type": {
          "const": "FundingAuthorization"
        },
        "scheme": {
          "enum": [
            "erc3009",
            "permit2"
          ]
        },
        "commitmentId": {
          "$ref": "common.schema.json#/$defs/Hex32"
        },
        "from": {
          "$ref": "common.schema.json#/$defs/Address"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "description": "Base units, decimal string"
        },
        "token": {
          "type": "string"
        },
        "validAfter": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "validBefore": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "nonce": {
          "$ref": "common.schema.json#/$defs/Hex32"
        },
        "expiresAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "signature": {
          "$ref": "common.schema.json#/$defs/Signature"
        }
      }
    },
    "EarlyAccept": {
      "type": "object",
      "description": "Buyer accepts a delivery before any decision; releases payment and the seller-supplied key for the buyer",
      "additionalProperties": false,
      "required": [
        "type",
        "commitmentId",
        "buyer",
        "attempt",
        "nonce",
        "expiresAt",
        "signature"
      ],
      "properties": {
        "type": {
          "const": "EarlyAccept"
        },
        "commitmentId": {
          "$ref": "common.schema.json#/$defs/Hex32"
        },
        "buyer": {
          "$ref": "common.schema.json#/$defs/Address"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "nonce": {
          "$ref": "common.schema.json#/$defs/Hex32"
        },
        "expiresAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "signature": {
          "$ref": "common.schema.json#/$defs/Signature"
        }
      }
    },
    "Decision": {
      "type": "object",
      "description": "An adjudicator's signed decision; the settlement layer checks seed, policy and registry before applying it",
      "additionalProperties": false,
      "required": [
        "type",
        "commitmentId",
        "attempt",
        "adjudicator",
        "role",
        "outcome",
        "seed",
        "policyHash",
        "registryHash",
        "judgmentRecordHash",
        "nonce",
        "expiresAt",
        "signature"
      ],
      "properties": {
        "type": {
          "const": "Decision"
        },
        "commitmentId": {
          "$ref": "common.schema.json#/$defs/Hex32"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "adjudicator": {
          "$ref": "common.schema.json#/$defs/Address"
        },
        "role": {
          "enum": [
            "primary",
            "fallback",
            "appeal"
          ]
        },
        "outcome": {
          "enum": [
            "accept",
            "reject",
            "escalate"
          ]
        },
        "seed": {
          "$ref": "common.schema.json#/$defs/Hex32",
          "description": "The panel seed for the decider's role (ADR-0018): the primary reveals the preimage of its acceptance's seedCommitment; fallback and appeal decisions use the beacon seed for the round fixed by judgeBy, the escalation or the appeal filing"
        },
        "policyHash": {
          "$ref": "common.schema.json#/$defs/Hex32"
        },
        "registryHash": {
          "$ref": "common.schema.json#/$defs/Hex32"
        },
        "judgmentRecordHash": {
          "$ref": "common.schema.json#/$defs/Hex32"
        },
        "keyForBuyer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scheme",
            "ciphertext"
          ],
          "properties": {
            "scheme": {
              "const": "x25519-xsalsa20poly1305"
            },
            "ciphertext": {
              "$ref": "common.schema.json#/$defs/Base64Url"
            }
          }
        },
        "appealGround": {
          "enum": [
            "wrong-outcome",
            "missing-or-wrong-key",
            "policy-or-panel-violation",
            "mislabeled-model"
          ],
          "description": "Appeal decisions only"
        },
        "nonce": {
          "$ref": "common.schema.json#/$defs/Hex32"
        },
        "expiresAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "signature": {
          "$ref": "common.schema.json#/$defs/Signature"
        },
        "beacon": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "round",
            "value"
          ],
          "description": "Beacon proof for a fallback or appeal panel seed. On SimChain the beacon is a settlement-layer fact; other sources carry the round's signature.",
          "properties": {
            "source": {
              "$ref": "common.schema.json#/$defs/RandomnessSource"
            },
            "round": {
              "type": "integer",
              "minimum": 0
            },
            "value": {
              "$ref": "common.schema.json#/$defs/Hex32"
            },
            "signature": {
              "type": "string",
              "pattern": "^0x([0-9a-f]{2}){1,256}$",
              "description": "The beacon's signature over the round (e.g. a 48-byte BLS signature for drand quicknet); lowercase, whole bytes"
            }
          },
          "if": {
            "type": "object",
            "properties": {
              "source": {
                "const": "sim"
              }
            },
            "required": [
              "source"
            ]
          },
          "else": {
            "required": [
              "signature"
            ],
            "type": "object",
            "properties": {
              "signature": {}
            }
          },
          "then": {
            "type": "object",
            "not": {
              "type": "object",
              "required": [
                "signature"
              ],
              "properties": {
                "signature": {}
              }
            }
          }
        },
        "encryptedKeys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/EncryptedKey"
          },
          "description": "On escalate: the content key encrypted to the appeal adjudicator (ADR-0020); only on escalate"
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "outcome": {
                "const": "escalate"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "encryptedKeys"
            ],
            "properties": {
              "encryptedKeys": {}
            }
          },
          "else": {
            "type": "object",
            "not": {
              "type": "object",
              "required": [
                "encryptedKeys"
              ],
              "properties": {
                "encryptedKeys": {}
              }
            }
          }
        }
      ]
    },
    "AgentRevocation": {
      "type": "object",
      "description": "Principal revokes an agent; blocks new commitments only",
      "additionalProperties": false,
      "required": [
        "type",
        "agent",
        "principal",
        "nonce",
        "expiresAt",
        "signature"
      ],
      "properties": {
        "type": {
          "const": "AgentRevocation"
        },
        "agent": {
          "$ref": "common.schema.json#/$defs/Address"
        },
        "principal": {
          "$ref": "common.schema.json#/$defs/Address"
        },
        "nonce": {
          "$ref": "common.schema.json#/$defs/Hex32"
        },
        "expiresAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "signature": {
          "$ref": "common.schema.json#/$defs/Signature"
        }
      }
    },
    "MemberAdmission": {
      "type": "object",
      "description": "Club operator admits a member principal",
      "additionalProperties": false,
      "required": [
        "type",
        "clubId",
        "member",
        "operator",
        "validUntil",
        "nonce",
        "expiresAt",
        "signature"
      ],
      "properties": {
        "type": {
          "const": "MemberAdmission"
        },
        "clubId": {
          "type": "string"
        },
        "member": {
          "$ref": "common.schema.json#/$defs/Address"
        },
        "operator": {
          "$ref": "common.schema.json#/$defs/Address"
        },
        "validUntil": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "nonce": {
          "$ref": "common.schema.json#/$defs/Hex32"
        },
        "expiresAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "signature": {
          "$ref": "common.schema.json#/$defs/Signature"
        }
      }
    },
    "MemberRevocation": {
      "type": "object",
      "description": "Club operator removes a member; blocks new commitments only",
      "additionalProperties": false,
      "required": [
        "type",
        "clubId",
        "member",
        "operator",
        "nonce",
        "expiresAt",
        "signature"
      ],
      "properties": {
        "type": {
          "const": "MemberRevocation"
        },
        "clubId": {
          "type": "string"
        },
        "member": {
          "$ref": "common.schema.json#/$defs/Address"
        },
        "operator": {
          "$ref": "common.schema.json#/$defs/Address"
        },
        "nonce": {
          "$ref": "common.schema.json#/$defs/Hex32"
        },
        "expiresAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "signature": {
          "$ref": "common.schema.json#/$defs/Signature"
        }
      }
    },
    "Dispute": {
      "type": "object",
      "description": "Optimistic mode: the buyer disputes a delivery before disputeBy, posting the dispute bond and the adjudication fee (ADR-0015)",
      "additionalProperties": false,
      "required": [
        "type",
        "commitmentId",
        "buyer",
        "attempt",
        "grounds",
        "bond",
        "fee",
        "encryptedKeys",
        "nonce",
        "expiresAt",
        "signature"
      ],
      "properties": {
        "type": {
          "const": "Dispute"
        },
        "commitmentId": {
          "$ref": "common.schema.json#/$defs/Hex32"
        },
        "buyer": {
          "$ref": "common.schema.json#/$defs/Address"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "grounds": {
          "type": "string",
          "maxLength": 2000,
          "x-holdback-untrusted": true
        },
        "bond": {
          "$ref": "common.schema.json#/$defs/TokenAmount"
        },
        "fee": {
          "$ref": "common.schema.json#/$defs/TokenAmount"
        },
        "nonce": {
          "$ref": "common.schema.json#/$defs/Hex32"
        },
        "expiresAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "signature": {
          "$ref": "common.schema.json#/$defs/Signature"
        },
        "encryptedKeys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/EncryptedKey"
          },
          "description": "The content key encrypted to the primary, fallback and appeal adjudicators (ADR-0020)"
        }
      }
    },
    "MutualSettlement": {
      "type": "object",
      "description": "Buyer and seller close a commitment by agreement (ADR-0019). Both sign the identical struct: everything except the two signatures.",
      "additionalProperties": false,
      "required": [
        "type",
        "commitmentId",
        "deliveryHash",
        "sellerAmount",
        "releaseKey",
        "nonce",
        "expiresAt",
        "buyerSignature",
        "sellerSignature"
      ],
      "properties": {
        "type": {
          "const": "MutualSettlement"
        },
        "commitmentId": {
          "$ref": "common.schema.json#/$defs/Hex32"
        },
        "deliveryHash": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/Hex32"
            },
            {
              "type": "null"
            }
          ],
          "description": "EIP-712 struct hash of the delivery being settled, or null before any delivery"
        },
        "sellerAmount": {
          "$ref": "common.schema.json#/$defs/TokenAmount",
          "description": "Paid to the seller, in the price token; the rest of the hold returns to the buyer"
        },
        "releaseKey": {
          "type": "boolean",
          "description": "Whether the seller-supplied key is released to the buyer with the payment; must be false when deliveryHash is null (ADR-0019)"
        },
        "nonce": {
          "$ref": "common.schema.json#/$defs/Hex32"
        },
        "expiresAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "buyerSignature": {
          "$ref": "common.schema.json#/$defs/Signature"
        },
        "sellerSignature": {
          "$ref": "common.schema.json#/$defs/Signature"
        }
      },
      "if": {
        "type": "object",
        "properties": {
          "deliveryHash": {
            "type": "null"
          }
        },
        "required": [
          "deliveryHash"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "releaseKey": {
            "const": false
          }
        },
        "required": [
          "releaseKey"
        ]
      }
    },
    "Publish": {
      "type": "object",
      "additionalProperties": false,
      "description": "Buyer and seller raise a commitment's disclosure level by agreement (ADR-0020). Both sign the identical struct. Raising only: the settlement layer refuses a level below the current one (T-006), which a schema cannot check.",
      "required": [
        "type",
        "commitmentId",
        "level",
        "nonce",
        "expiresAt",
        "buyerSignature",
        "sellerSignature"
      ],
      "properties": {
        "type": {
          "const": "Publish"
        },
        "commitmentId": {
          "$ref": "common.schema.json#/$defs/Hex32"
        },
        "level": {
          "$ref": "common.schema.json#/$defs/DisclosureLevel"
        },
        "nonce": {
          "$ref": "common.schema.json#/$defs/Hex32"
        },
        "expiresAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        },
        "buyerSignature": {
          "$ref": "common.schema.json#/$defs/Signature"
        },
        "sellerSignature": {
          "$ref": "common.schema.json#/$defs/Signature"
        }
      }
    }
  }
}
