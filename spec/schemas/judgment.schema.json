{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://holdback.dev/schemas/v0.2/judgment.schema.json",
  "title": "Judgment record",
  "type": "object",
  "required": [
    "commitmentId",
    "attempt",
    "adjudicator",
    "role",
    "intake",
    "deterministic",
    "screen",
    "panel",
    "aggregate",
    "recordHash",
    "decidedAt",
    "signature"
  ],
  "additionalProperties": false,
  "properties": {
    "commitmentId": {
      "$ref": "common.schema.json#/$defs/Hex32"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "adjudicator": {
      "$ref": "common.schema.json#/$defs/Address"
    },
    "role": {
      "enum": [
        "primary",
        "fallback",
        "appeal"
      ]
    },
    "intake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plaintextHashVerified",
        "mime",
        "bytes",
        "normalized"
      ],
      "properties": {
        "plaintextHashVerified": {
          "type": "boolean"
        },
        "mime": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "normalized": {
          "type": "boolean"
        }
      }
    },
    "deterministic": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "checkId",
          "required",
          "passed"
        ],
        "properties": {
          "checkId": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "passed": {
            "type": "boolean"
          },
          "detail": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "screen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flagged",
        "signals"
      ],
      "properties": {
        "flagged": {
          "type": "boolean"
        },
        "signals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "instruction_phrase",
                  "encoded_run",
                  "unicode_tags",
                  "zero_width",
                  "canary_echo",
                  "classifier"
                ]
              },
              "detail": {
                "type": "string",
                "maxLength": 300
              }
            }
          }
        }
      }
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ran",
        "policyId",
        "panelCommitment",
        "members"
      ],
      "properties": {
        "ran": {
          "type": "boolean"
        },
        "policyId": {
          "type": "string"
        },
        "panelCommitment": {
          "$ref": "common.schema.json#/$defs/Hex32"
        },
        "seed": {
          "$ref": "common.schema.json#/$defs/Hex32"
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "judgeId",
              "provider",
              "family",
              "model",
              "promptHash",
              "rubricHash",
              "status"
            ],
            "properties": {
              "judgeId": {
                "type": "string"
              },
              "provider": {
                "type": "string"
              },
              "family": {
                "type": "string"
              },
              "model": {
                "type": "string",
                "not": {
                  "pattern": "[Ll][Aa][Tt][Ee][Ss][Tt]"
                },
                "description": "Pinned model ID; floating aliases such as 'latest' are rejected"
              },
              "promptHash": {
                "$ref": "common.schema.json#/$defs/Hex32"
              },
              "rubricHash": {
                "$ref": "common.schema.json#/$defs/Hex32"
              },
              "latencyMs": {
                "type": "integer",
                "minimum": 0
              },
              "status": {
                "enum": [
                  "ok",
                  "abstain",
                  "timeout",
                  "error",
                  "recorded"
                ]
              },
              "verdict": {
                "$ref": "judge-verdict.schema.json"
              }
            }
          }
        }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "reasons"
      ],
      "properties": {
        "decision": {
          "enum": [
            "accept",
            "reject",
            "escalate"
          ]
        },
        "weightedScore": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 4
        },
        "passShare": {
          "$ref": "common.schema.json#/$defs/Rate"
        },
        "failShare": {
          "$ref": "common.schema.json#/$defs/Rate"
        },
        "passFamilies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "recordUri": {
      "type": "string",
      "format": "uri"
    },
    "recordHash": {
      "$ref": "common.schema.json#/$defs/Hex32"
    },
    "decidedAt": {
      "$ref": "common.schema.json#/$defs/Timestamp"
    },
    "signature": {
      "$ref": "common.schema.json#/$defs/Signature"
    }
  }
}
