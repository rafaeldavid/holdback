{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://holdback.dev/schemas/v0.5/adjudicator.schema.json",
  "title": "Adjudicator registration",
  "type": "object",
  "required": [
    "address",
    "name",
    "encryptionPublicKey",
    "affiliations",
    "policy",
    "registry",
    "policyHash",
    "fee",
    "status",
    "pool",
    "poolTermsHash"
  ],
  "additionalProperties": false,
  "properties": {
    "address": {
      "$ref": "common.schema.json#/$defs/Address"
    },
    "name": {
      "type": "string",
      "maxLength": 120,
      "x-holdback-untrusted": true
    },
    "encryptionPublicKey": {
      "$ref": "common.schema.json#/$defs/Base64Url"
    },
    "affiliations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Member IDs the adjudicator is affiliated with; it may not judge their commitments"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "panelSize",
        "appealPanelSize",
        "minFamilies",
        "minFamiliesAppeal",
        "minValid",
        "minValidAppeal",
        "acceptSupermajority",
        "rejectSupermajority",
        "judgeTimeoutSec",
        "rationaleMaxChars",
        "promptTemplateHash",
        "appealPromptTemplateHash",
        "aggregationVersion",
        "screenVersion",
        "providerPrivacy",
        "disclosureMin"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "panelSize": {
          "type": "integer",
          "minimum": 3
        },
        "appealPanelSize": {
          "type": "integer",
          "minimum": 5
        },
        "minFamilies": {
          "type": "integer",
          "minimum": 2
        },
        "minFamiliesAppeal": {
          "type": "integer",
          "minimum": 2
        },
        "minValid": {
          "type": "integer",
          "minimum": 2
        },
        "minValidAppeal": {
          "type": "integer",
          "minimum": 3
        },
        "acceptSupermajority": {
          "$ref": "common.schema.json#/$defs/Rate"
        },
        "rejectSupermajority": {
          "$ref": "common.schema.json#/$defs/Rate"
        },
        "judgeTimeoutSec": {
          "type": "integer",
          "minimum": 1
        },
        "rationaleMaxChars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "promptTemplateHash": {
          "$ref": "common.schema.json#/$defs/Hex32",
          "description": "SHA-256 of the fixed first-instance judge prompt template, before any commitment data is filled in"
        },
        "appealPromptTemplateHash": {
          "$ref": "common.schema.json#/$defs/Hex32",
          "description": "SHA-256 of the fixed appeal judge prompt template"
        },
        "aggregationVersion": {
          "type": "string",
          "description": "Version of the deterministic aggregation rule (docs/judgment-and-defenses.md)"
        },
        "screenVersion": {
          "type": "string",
          "description": "Version of the normalization and screen step"
        },
        "providerPrivacy": {
          "enum": [
            "standard",
            "zdr",
            "tee",
            "local"
          ],
          "description": "How the adjudicator's model providers treat deliverables: standard terms, zero data retention, a trusted execution environment, or models run locally (ADR-0020)"
        },
        "disclosureMin": {
          "$ref": "common.schema.json#/$defs/DisclosureLevel",
          "description": "Lowest disclosure level this adjudicator accepts"
        }
      },
      "description": "The adjudicator policy. Its keccak256 over RFC 8785 canonical JSON is the policyHash a commitment binds."
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hash",
        "uri"
      ],
      "properties": {
        "hash": {
          "$ref": "common.schema.json#/$defs/Hex32"
        },
        "uri": {
          "type": "string",
          "format": "uri"
        }
      },
      "description": "The judge registry this adjudicator draws panels from; commitments bind its hash"
    },
    "policyHash": {
      "$ref": "common.schema.json#/$defs/Hex32",
      "description": "keccak256 of the RFC 8785 canonical JSON of policy; commitments bind it"
    },
    "fee": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min"
      ],
      "properties": {
        "min": {
          "$ref": "common.schema.json#/$defs/TokenAmount"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "falseAcceptRate",
        "falseRejectRate",
        "escalationRate",
        "sampleSize",
        "measuredAt"
      ],
      "properties": {
        "falseAcceptRate": {
          "$ref": "common.schema.json#/$defs/Rate"
        },
        "falseRejectRate": {
          "$ref": "common.schema.json#/$defs/Rate"
        },
        "escalationRate": {
          "$ref": "common.schema.json#/$defs/Rate"
        },
        "sampleSize": {
          "type": "integer",
          "minimum": 0
        },
        "measuredAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        }
      }
    },
    "status": {
      "enum": [
        "active",
        "suspended"
      ]
    },
    "pool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "junior",
        "senior",
        "reserved",
        "terms"
      ],
      "description": "The adjudicator's bond pool (ADR-0014 §2a). Junior is the adjudicator's own stake and takes losses first; senior is backers' stake, pro rata. Senior stays empty in Phase 1. The total bond is junior + senior and the open exposure is reserved; there is no separate bond field to disagree with them.",
      "properties": {
        "junior": {
          "$ref": "common.schema.json#/$defs/TokenAmount"
        },
        "senior": {
          "$ref": "common.schema.json#/$defs/TokenAmount"
        },
        "reserved": {
          "$ref": "common.schema.json#/$defs/TokenAmount",
          "description": "Encumbered by open commitments; the coverage gate is junior + senior - reserved >= price"
        },
        "terms": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "capitalChargeRate",
            "capitalChargeToPoolRate",
            "firstLossShare",
            "noticePeriodSec"
          ],
          "description": "What backers deposit under. Its keccak256 over RFC 8785 canonical JSON is poolTermsHash.",
          "properties": {
            "capitalChargeRate": {
              "$ref": "common.schema.json#/$defs/Rate",
              "description": "Quoted capital charge as a share of price (moved from fee in v0.5)"
            },
            "capitalChargeToPoolRate": {
              "$ref": "common.schema.json#/$defs/Rate",
              "description": "Share of the capital charge paid to the pool pro rata (from Phase 4)"
            },
            "firstLossShare": {
              "$ref": "common.schema.json#/$defs/Rate",
              "description": "Junior's minimum share of the pool; at least the rulebook's firstLossShareMin"
            },
            "noticePeriodSec": {
              "type": "integer",
              "minimum": 0,
              "description": "Withdrawal notice for backers"
            }
          }
        }
      }
    },
    "poolTermsHash": {
      "$ref": "common.schema.json#/$defs/Hex32",
      "description": "keccak256 of the RFC 8785 canonical JSON of pool.terms; a backer's deposit binds it"
    }
  }
}
