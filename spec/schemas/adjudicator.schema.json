{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://holdback.dev/schemas/v0.4/adjudicator.schema.json",
  "title": "Adjudicator registration",
  "type": "object",
  "required": [
    "address",
    "name",
    "encryptionPublicKey",
    "affiliations",
    "bond",
    "openExposure",
    "policy",
    "registry",
    "policyHash",
    "fee",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "address": {
      "$ref": "common.schema.json#/$defs/Address"
    },
    "name": {
      "type": "string",
      "maxLength": 120
    },
    "encryptionPublicKey": {
      "$ref": "common.schema.json#/$defs/Base64Url"
    },
    "affiliations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Member IDs the adjudicator is affiliated with; it may not judge their commitments"
    },
    "bond": {
      "$ref": "common.schema.json#/$defs/TokenAmount"
    },
    "openExposure": {
      "$ref": "common.schema.json#/$defs/TokenAmount"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "panelSize",
        "appealPanelSize",
        "minFamilies",
        "minFamiliesAppeal",
        "minValid",
        "minValidAppeal",
        "acceptSupermajority",
        "rejectSupermajority",
        "judgeTimeoutSec",
        "rationaleMaxChars",
        "promptTemplateHash",
        "appealPromptTemplateHash",
        "aggregationVersion",
        "screenVersion"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "panelSize": {
          "type": "integer",
          "minimum": 3
        },
        "appealPanelSize": {
          "type": "integer",
          "minimum": 5
        },
        "minFamilies": {
          "type": "integer",
          "minimum": 2
        },
        "minFamiliesAppeal": {
          "type": "integer",
          "minimum": 2
        },
        "minValid": {
          "type": "integer",
          "minimum": 2
        },
        "minValidAppeal": {
          "type": "integer",
          "minimum": 3
        },
        "acceptSupermajority": {
          "$ref": "common.schema.json#/$defs/Rate"
        },
        "rejectSupermajority": {
          "$ref": "common.schema.json#/$defs/Rate"
        },
        "judgeTimeoutSec": {
          "type": "integer",
          "minimum": 1
        },
        "rationaleMaxChars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "promptTemplateHash": {
          "$ref": "common.schema.json#/$defs/Hex32",
          "description": "SHA-256 of the fixed first-instance judge prompt template, before any commitment data is filled in"
        },
        "appealPromptTemplateHash": {
          "$ref": "common.schema.json#/$defs/Hex32",
          "description": "SHA-256 of the fixed appeal judge prompt template"
        },
        "aggregationVersion": {
          "type": "string",
          "description": "Version of the deterministic aggregation rule (docs/judgment-and-defenses.md)"
        },
        "screenVersion": {
          "type": "string",
          "description": "Version of the normalization and screen step"
        }
      },
      "description": "The adjudicator policy. Its keccak256 over RFC 8785 canonical JSON is the policyHash a commitment binds."
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hash",
        "uri"
      ],
      "properties": {
        "hash": {
          "$ref": "common.schema.json#/$defs/Hex32"
        },
        "uri": {
          "type": "string",
          "format": "uri"
        }
      },
      "description": "The judge registry this adjudicator draws panels from; commitments bind its hash"
    },
    "policyHash": {
      "$ref": "common.schema.json#/$defs/Hex32",
      "description": "keccak256 of the RFC 8785 canonical JSON of policy; commitments bind it"
    },
    "fee": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "capitalChargeRate"
      ],
      "properties": {
        "min": {
          "$ref": "common.schema.json#/$defs/TokenAmount"
        },
        "capitalChargeRate": {
          "$ref": "common.schema.json#/$defs/Rate"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "falseAcceptRate",
        "falseRejectRate",
        "escalationRate",
        "sampleSize",
        "measuredAt"
      ],
      "properties": {
        "falseAcceptRate": {
          "$ref": "common.schema.json#/$defs/Rate"
        },
        "falseRejectRate": {
          "$ref": "common.schema.json#/$defs/Rate"
        },
        "escalationRate": {
          "$ref": "common.schema.json#/$defs/Rate"
        },
        "sampleSize": {
          "type": "integer",
          "minimum": 0
        },
        "measuredAt": {
          "$ref": "common.schema.json#/$defs/Timestamp"
        }
      }
    },
    "status": {
      "enum": [
        "active",
        "suspended"
      ]
    }
  }
}
