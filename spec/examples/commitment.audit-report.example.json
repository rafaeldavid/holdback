                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "severity",
                  "title",
                  "locations",
                  "rootCause",
                  "recommendedFix"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^F-[0-9]{2,4}$"
                  },
                  "severity": {
                    "enum": [
                      "Critical",
                      "High",
                      "Medium",
                      "Low",
                      "Info"
                    ]
                  },
                  "status": {
                    "enum": [
                      "open",
                      "fixed",
                      "acknowledged"
                    ]
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "locations": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
