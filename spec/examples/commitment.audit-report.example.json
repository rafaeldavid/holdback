              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "reportDate": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000
            },
            "salt": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$"
            },
            "filesReviewed": {
