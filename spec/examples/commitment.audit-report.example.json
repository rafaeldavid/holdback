                          "maxLength": 2000
                        }
                      }
                    }
                  },
                  "rootCause": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "impact": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
